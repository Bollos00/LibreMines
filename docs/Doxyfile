# Doxyfile for LibreMines documentation generation
# This file is used by Doxygen to generate HTML and LaTeX documentation

PROJECT_NAME           = "LibreMines"
PROJECT_NUMBER         = 2.3.0
PROJECT_BRIEF          = "A Free/Libre Qt6 Minesweeper Game"
PROJECT_LOGO           = ../share/icons/libremines.svg

# Output directory for documentation
OUTPUT_DIRECTORY       = ./generated
CREATE_SUBDIRS         = NO

# Input files and patterns
INPUT                  = ../src/ ../include/
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cpp *.hpp *.cc *.cxx

# Documentation generation options
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

# Documentation style
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NAMETYPES = NO

# Behaviour of members
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_IN_BODY_DOCS      = NO

# Search and cross-referencing
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST= YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = YES

# C++ related options
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_OUTPUT_VHDL   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_SLICE  = NO

# C++ specific settings
CPP_CLI_SUPPORT        = NO
SET_CUSTOM_EXTENSIONS  = NO
SIP_SUPPORT            = NO
IDL_SUPPORT            = NO
INTERNAL_DOCS          = NO
LIFETIME_DURATION_SINCE= 2020
EXTERNAL_SYMBOL_MAPPING=

# Dot graph settings
CLASS_DIAGRAMS         = YES
HAVE_DOT               = YES
DOT_NUM_THREADS        = 4
DOT_FONTNAME           = Helvetica
DOT_FONTSIZE           = 10
DOT_GRAPH_MAX_NODES    = 50
DOT_TRANSPARENCY       = 0
DOT_MULTIPLE_TARGETS   = NO
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES

# Recursive documentation
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */moc_* */ui_* */.git/*
EXCLUDE_SYMBOLS        = std::* Qt::* Q_* MOC_* UI_*

# Qt specific
PREDEFINED             = QT_CORE_LIB QT_GUI_LIB QT_WIDGETS_LIB QT_MULTIMEDIA_LIB \
                         Q_OBJECT \
                         Q_SIGNALS=signals: \
                         Q_SLOTS=public slots: \
                         Q_EMIT=

# Aliases for common patterns in LibreMines
ALIASES                = "since=\xrefitem since \"Since\" \"Since\"" \
                         "author=\xrefitem author \"Author\" \"Authors\"" \
                         "todo=\xrefitem todo \"Todo\" \"Todo Items\"" \
                         "bug=\xrefitem bug \"Bug\" \"Bugs\"" \
                         "warning=\warning" \
                         "note=\note" \
                         "param=\param" \
                         "return=\return"

# Search functionality
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO

# Output format options
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
EXT_LINKS_IN_WINDOW    = NO

# LaTeX output (disabled)
LATEX_OUTPUT           = latex
LATEX_CMD_NAME         = latex
MAKEINDEX_CMD_NAME     = makeindex
COMPACT_LATEX          = NO
PAPER_TYPE             = a4
EXTRA_PACKAGES         = 
